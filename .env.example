# Browser: Supabase Auth only. These values are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Vercel server only: use the Supabase transaction pooler connection string.
SUPABASE_DATABASE_URL=postgresql://postgres.your-project:password@pooler.supabase.com:6543/postgres?sslmode=require
